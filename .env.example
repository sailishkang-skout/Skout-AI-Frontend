# Workspace context (until auth lands) — must match the API default tenant
NEXT_PUBLIC_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# Auth (Clerk) — Sprint 1
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

